<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.brewkery.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_home_to_cart"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.brewkery.ui.detail.DetailFragment"
        android:label="Detail">
        <argument
            android:name="itemId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.brewkery.ui.cart.CartFragment"
        android:label="Cart">
        <action
            android:id="@+id/action_cart_to_status"
            app:destination="@id/orderStatusFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderStatusFragment"
        android:name="com.brewkery.ui.status.OrderStatusFragment"
        android:label="Order Status">
        <argument android:name="ticketId" app:argType="string" />
        <argument android:name="itemCount" app:argType="integer" />
        <argument android:name="waitTime" app:argType="string" />
    </fragment>
</navigation>